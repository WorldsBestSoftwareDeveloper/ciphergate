# CipherGate — Environment Variables
# Copy to .env.local:  cp .env.local.example .env.local

# ─── Solana (Devnet only) ─────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# ─── Arcium MPC (Devnet) ──────────────────────────────────────────────────
# Official Arcium devnet cluster offset (docs.arcium.com/developers/deployment)
NEXT_PUBLIC_ARCIUM_CLUSTER_OFFSET=456

# DEMO_MODE = simulated MPC in localStorage (works without any Arcium install)
# https://api.devnet.solana.com = real Arcium devnet (requires arcium deploy)
NEXT_PUBLIC_ARCIUM_ENDPOINT=DEMO_MODE

# Your deployed Arcium MXE program ID (after: arcium deploy --cluster-offset 456)
NEXT_PUBLIC_ARCIUM_PROGRAM_ID=

# ─── Anchor Program ───────────────────────────────────────────────────────
# Your deployed Anchor program ID (after: anchor deploy --provider.cluster devnet)
NEXT_PUBLIC_PROGRAM_ID=

# ─── IPFS (optional) ─────────────────────────────────────────────────────
# Free token at https://web3.storage — leave blank for local IndexedDB demo mode
NEXT_PUBLIC_WEB3_STORAGE_TOKEN=
